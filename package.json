{
  "name": "hanabi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hanabi/web dev",
    "typecheck": "tsc && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "simulate": "node packages/ai/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0"
}
